# Copia este archivo como .env para trabajar localmente con Docker.
# Este modo levanta app + PostgreSQL + panel web de base de datos.

WEB_PORT=8080
APP_PORT=8081
ADMINER_PORT=8082
DB_HOST_PORT=5432

PORT=8081

# Estos valores son para la red interna de Docker.
# No uses localhost aqui, porque la app corre dentro de un contenedor.
DB_HOST=postgres
DB_PORT=5432
DB_NAME=tickets_db
DB_USER=tickets_user
DB_PASSWORD=tickets_password

POSTGRES_DB=tickets_db
POSTGRES_USER=tickets_user
POSTGRES_PASSWORD=tickets_password
