# Copia este archivo como .env cuando quieras conectar la app Docker
# a una base PostgreSQL que esta en otra PC o servidor.

APP_PORT=8081
PORT=8081

# IP LAN o DNS de la PC/servidor donde corre PostgreSQL.
DB_HOST=192.168.1.50
DB_PORT=5432
DB_NAME=tickets_db
DB_USER=postgres
DB_PASSWORD=tu_clave

# Opcional: si defines DB_URL, la app la usara en vez de DB_HOST/DB_PORT/DB_NAME.
# DB_URL=jdbc:postgresql://192.168.1.50:5432/tickets_db
